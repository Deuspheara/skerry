            "value": "チャットするには設定でログアウトして再ログインしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅하려면 설정에서 로그아웃 후 다시 로그인하세요"
          }
        },
        "ms": {
          "stringUnit": {
