            "value": "Излез и влез отново от Настройки, за да пишеш в чата"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca la sessió i torna a entrar a Configuració per poder xatejar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlaste se a znovu přihlaste v Nastavení, abyste mohli chatovat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ud og ind igen i Indstillinger for at kunne chatte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den Einstellungen ab und wieder an, um zu chatten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποσυνδέσου και συνδέσου ξανά από τις Ρυθμίσεις για να συνομιλείς"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra sesión y vuelve a entrar en Ajustes para poder chatear"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu ulos ja takaisin sisään Asetuksissa voidaksesi chattailla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous puis reconnectez-vous dans les réglages pour pouvoir écrire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट करने के लिए सेटिंग में साइन आउट करके दोबारा साइन इन करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavi se i ponovno prijavi u Postavkama kako bi mogao chatati"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz ki, majd be újra a Beállításokban a csevegéshez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar lalu masuk lagi di Pengaturan agar bisa mengobrol"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci e accedi di nuovo dalle Impostazioni per poter scrivere in chat"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התנתקו והתחברו מחדש בהגדרות כדי לשוחח בצ׳אט"
