    "phone_settings_feed_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews play live streams as you swipe, which uses data and battery. Twitch can show an ad when a stream starts: the app never skips or hides it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغّل المعاينات البثوث المباشرة أثناء التمرير، مما يستهلك البيانات والبطارية. قد يعرض Twitch إعلاناً عند بدء البث: لا يتجاوزه التطبيق ولا يخفيه أبداً."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus lisent des directs au fil des glissements, ce qui consomme des données et de la batterie. Twitch peut afficher une publicité au démarrage d'un direct : l'application ne la saute ni ne la masque jamais."
          }
        }
      }
