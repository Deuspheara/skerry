    "vod_subs_line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch only plays it in its own apps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّلها Twitch في تطبيقاته فقط."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa sarili lang nitong apps ito pinapatugtog ng Twitch."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch го пуска само в собствените си приложения."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch només la reprodueix a les seves apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ho přehrává jen ve svých aplikacích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch afspiller den kun i sine egne apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch spielt sie nur in eigenen Apps ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Twitch την παίζει μόνο στις δικές του εφαρμογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch solo la reproduce en sus propias apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch toistaa sen vain omissa sovelluksissaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ne le lit que dans ses propres applications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch इसे केवल अपने ऐप्स में चलाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch je reproducira samo u svojim aplikacijama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twitch csak a saját alkalmazásaiban játssza le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch hanya memutarnya di aplikasinya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch lo riproduce solo nelle sue app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch מנגן אותו רק באפליקציות שלו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch の公式アプリでのみ再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 자체 앱에서만 재생됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch hanya memainkannya dalam aplikasinya sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch spiller den bare av i sine egne apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch speelt hem alleen af in eigen apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch odtwarza ją tylko we własnych aplikacjach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twitch só o reproduz nos próprios apps."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twitch só a reproduz nas suas próprias apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch o redă doar în aplicațiile proprii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch воспроизводит её только в своих приложениях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ho prehráva len vo svojich aplikáciách."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch spelar upp den bara i sina egna appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch เล่นได้เฉพาะในแอปของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch bunu yalnızca kendi uygulamalarında oynatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch відтворює його лише у своїх застосунках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch chỉ phát nó trong ứng dụng của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 仅允许在其自家应用中播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 僅允許在其自家應用程式中播放。"
          }
        }
      }
