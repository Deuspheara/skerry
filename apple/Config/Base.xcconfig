// Shared build settings. The public Twitch client id (there is no secret) goes in Local.xcconfig, which is git-ignored:
//   TWITCH_CLIENT_ID = <your client id>
TWITCH_CLIENT_ID =
// Optional: client id for the unofficial playback requests; empty keeps native playback off (see LEGAL.md).
TWITCH_PLAYBACK_CLIENT_ID =
#include? "Local.xcconfig"
