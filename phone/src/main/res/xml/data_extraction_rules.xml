<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred: the sign-in tokens are encrypted with a key that lives in this device's Android Keystore,
  so a restored copy would be unreadable, and every other file is a cache the app rebuilds.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
